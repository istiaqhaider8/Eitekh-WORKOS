datasource db {
  // PROD-1. SQLite has a single writer and is file-local: concurrent writes
  // from different tenants serialise, and more than one app instance cannot
  // share the database. WAL (added 2026-09-18) removed reader/writer contention
  // and is why task open is fast, but it still allows exactly one writer, so it
  // never lifted that ceiling.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// USER & IDENTITY
// -------------------------------------------------------------
model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  firstName         String
  lastName          String
  avatarUrl         String?
  jobTitle          String?
  company           String?
  timezone          String    @default("UTC")
  language          String    @default("en")
  isSuperAdmin      Boolean   @default(false)
  isSupportAdmin    Boolean   @default(false)
  status            String    @default("ACTIVE") // ACTIVE, SUSPENDED, PENDING_VERIFY
  // EMPLOYEE for internal staff, CLIENT for external customer contacts.
  // Kept as a String with a CHECK constraint in the migration because this
  // schema uses no Prisma enums and SQLite has no native enum type; the allowed
  // values live in ONE place, USER_TYPES in src/lib/validation.ts.
  userType          String    @default("EMPLOYEE") // EMPLOYEE, CLIENT
  mfaEnabled        Boolean   @default(false)
  mfaSecret         String?
  recoveryCodes     String? // JSON array of hashed recovery codes
  notificationPrefs String? // JSON: { [NotificationType]: { inApp: boolean, email: boolean } }
  emailVerifiedAt   DateTime?
  verificationToken String?
  resetToken        String?
  resetTokenExp     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sessions               Session[]
  orgMemberships         OrganizationMember[]
  workspaceMemberships   WorkspaceMember[]
  teamMemberships        TeamMember[]
  projectMemberships     ProjectMember[]
  reportedIssues         Issue[]              @relation("IssueReporter")
  assignedIssues         Issue[]              @relation("IssueAssignee")
  assignedSubtasks       Subtask[]
  comments               Comment[]
  timeEntries            TimeEntry[]
  watchers               Watcher[]
  notifications          Notification[]
  triggeredNotifications Notification[]       @relation("NotificationActor")
  activityLogs           ActivityLog[]
  attachments            Attachment[]
  leaves                 Leave[]
  originalDelegations    TaskDelegation[]     @relation("DelegationOriginalAssignee")
  receivedDelegations    TaskDelegation[]     @relation("DelegationDelegateUser")
  createdDelegations     TaskDelegation[]     @relation("DelegationCreator")
  delegationHistories    DelegationHistory[]
  activatePhasesOwned      ActivatePhase[]        @relation("ActivatePhaseOwner")
  activateWorkstreamsOwned ActivateWorkstream[]   @relation("ActivateWorkstreamOwner")
  activateGateApprovals    ActivateGateApproval[] @relation("ActivateGateApprover")
  activateGatesRaised      ActivateGate[]         @relation("ActivateGateRaiser")
  activateModulesOwned     ActivateProjectModule[] @relation("ActivateModuleOwner")
  activateDecisionsMade    ActivateDecision[]      @relation("ActivateDecisionDecider")
  activateQuestionsOwned   ActivateDecision[]      @relation("ActivateQuestionOwner")
  activateDeltasOwned      ActivateDelta[]         @relation("ActivateDeltaOwner")
  activateCustomScope      ActivateCustomScopeItem[] @relation("ActivateCustomScopeAuthor")

  @@index([userType])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  userAgent    String?
  ipAddress    String?
  os           String?
  browser      String?
  location     String?
  lastActiveAt DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpCode {
  id          String    @id @default(cuid())
  email       String
  codeHash    String
  purpose     String // REGISTRATION, PASSWORD_RESET
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  usedAt      DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([email, purpose])
}

model Invitation {
  id          String    @id @default(cuid())
  email       String
  tokenHash   String    @unique
  invitedBy   String
  orgId       String
  workspaceId String?
  projectId   String?
  role        String    @default("MEMBER")
  status      String    @default("PENDING") // PENDING, ACCEPTED, EXPIRED
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([email])
}

// -------------------------------------------------------------
// TENANCY HIERARCHY: Organization -> Workspace -> Team -> Project
// -------------------------------------------------------------
model Organization {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  logoUrl      String?
  domain       String?
  timezone     String   @default("UTC")
  language     String   @default("en")
  dateFormat   String   @default("YYYY-MM-DD")
  workingDays  String   @default("1,2,3,4,5") // Mon-Fri
  workingHours String   @default("09:00-17:00")
  status       String   @default("ACTIVE") // ACTIVE, SUSPENDED, ARCHIVED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members     OrganizationMember[]
  workspaces  Workspace[]
  webhooks    Webhook[]
  leaves      Leave[]
  invitations Invitation[]
  /// Methodology templates this organization authored. Built-in templates
  /// have a null orgId and belong to nobody.
  methodTemplates MethodTemplate[]
}

model OrganizationMember {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  role      String   @default("MEMBER") // OWNER, ADMIN, MEMBER, GUEST
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
  @@index([orgId])
  @@index([orgId, role])
}

model Workspace {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  slug        String
  description String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members      WorkspaceMember[]
  teams        Team[]
  projects     Project[]

  @@index([orgId])
  @@index([orgId, isArchived])
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   @default("MEMBER") // WORKSPACE_ADMIN, MEMBER, VIEWER
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
}

model Team {
  id          String   @id @default(cuid())
  workspaceId String
  projectId   String?
  name        String
  description String?
  avatarUrl   String?
  leadId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?     @relation("ProjectTeamsList", fields: [projectId], references: [id], onDelete: Cascade)
  members   TeamMember[]
  projects  Project[]
  sprints   Sprint[]
  issues    Issue[]

  @@index([workspaceId])
  @@index([leadId])
  @@index([projectId])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      String   @default("MEMBER") // LEAD, MEMBER
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@index([teamId])
}

// -------------------------------------------------------------
// PROJECT & ISSUE HIERARCHY
// -------------------------------------------------------------
model Project {
  id           String    @id @default(cuid())
  workspaceId  String
  teamId       String?
  name         String
  key          String // e.g. DEV, CP
  description  String?
  ownerId      String
  template     String    @default("SCRUM") // SCRUM, KANBAN, BUG_TRACKING, GENERAL
  status       String    @default("ACTIVE") // PLANNING, ACTIVE, ON_HOLD, COMPLETED, ARCHIVED
  priority     String    @default("MEDIUM")
  issueCounter Int       @default(0)
  startDate    DateTime?
  targetDate   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  /// M4 — optimistic locking. Incremented on every update; a client that
  /// sends a stale value is told so rather than silently overwriting an edit
  /// it never saw. Opt-in: a request with no `version` behaves as before.
  version Int @default(0)

  /// D1 — full-text search vector over key, name and description.
  /// See Issue.searchVector for why the default is declared this way.
  searchVector Unsupported("tsvector")? @default(dbgenerated("((setweight(to_tsvector('english'::regconfig, COALESCE(key, ''::text)), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, COALESCE(name, ''::text)), 'A'::\"char\")) || setweight(to_tsvector('english'::regconfig, COALESCE(description, ''::text)), 'B'::\"char\"))"))

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team            Team?            @relation(fields: [teamId], references: [id])
  projectTeams    Team[]           @relation("ProjectTeamsList")
  members         ProjectMember[]
  components      Component[]
  epics           Epic[]
  activateProfile   ActivateProfile?
  activatePhases    ActivatePhase[]
  activateWorkstreams ActivateWorkstream[]
  sprints         Sprint[]
  workflows       Workflow[]
  issues          Issue[]
  labels          Label[]
  automationRules AutomationRule[]
  recurringTasks  RecurringTask[]
  webhooks        Webhook[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([status])
  @@index([createdAt])
  @@index([ownerId])
  @@index([teamId])
  @@index([searchVector], type: Gin)
  activateModules   ActivateProjectModule[]
  activateDecisions ActivateDecision[]
  activateCustomScopeItems ActivateCustomScopeItem[]
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("MEMBER") // PROJECT_ADMIN, PROJECT_MANAGER, MEMBER, VIEWER
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
  @@index([projectId, role])
  @@index([userId, role])
}

model Component {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?
  ownerId     String?
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]

  @@index([projectId])
}

model Epic {
  id         String    @id @default(cuid())
  projectId  String
  name       String
  summary    String?
  color      String    @default("#3b82f6")
  ownerId    String?
  status     String    @default("ACTIVE") // PLANNING, ACTIVE, DONE
  startDate  DateTime?
  targetDate DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  /// M4 — optimistic locking. Incremented on every update; a client that
  /// sends a stale value is told so rather than silently overwriting an edit
  /// it never saw. Opt-in: a request with no `version` behaves as before.
  version Int @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]

  @@index([projectId])
}

model Sprint {
  id                 String    @id @default(cuid())
  projectId          String
  teamId             String?
  name               String
  goal               String?
  startDate          DateTime?
  endDate            DateTime?
  status             String    @default("FUTURE") // FUTURE, ACTIVE, COMPLETED
  position           Int       @default(0)
  plannedPoints      Int?
  completedPoints    Int?
  completedAt        DateTime?
  retrospectiveNotes String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  /// M4 — optimistic locking. Incremented on every update; a client that
  /// sends a stale value is told so rather than silently overwriting an edit
  /// it never saw. Opt-in: a request with no `version` behaves as before.
  version Int @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team    Team?   @relation(fields: [teamId], references: [id])
  issues  Issue[]

  @@index([projectId])
  @@index([status])
  @@index([projectId, position])
  @@index([teamId])
}

model Workflow {
  id        String   @id @default(cuid())
  projectId String
  name      String
  isDefault Boolean  @default(true)
  createdAt DateTime @default(now())

  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  statuses    WorkflowStatus[]
  transitions WorkflowTransition[]

  @@index([projectId])
}

model WorkflowStatus {
  id         String @id @default(cuid())
  workflowId String
  name       String
  category   String @default("TO_DO") // BACKLOG, TO_DO, IN_PROGRESS, REVIEW, TESTING, DONE
  color      String @default("#6b7280")
  position   Int    @default(0)
  wipLimit   Int?

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  issues   Issue[]

  @@index([workflowId])
}

model WorkflowTransition {
  id           String  @id @default(cuid())
  workflowId   String
  fromStatusId String
  toStatusId   String
  requiredRole String?

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([fromStatusId])
  @@index([toStatusId])
}

// -------------------------------------------------------------
// CORE ISSUE TRACKING
// -------------------------------------------------------------
model Issue {
  id             String    @id @default(cuid())
  projectId      String
  keyNumber      Int // 1, 2, 3...
  issueKey       String // DEV-1, DEV-2...
  title          String
  description    String? // Markdown rich text
  issueType      String    @default("TASK") // TASK, BUG, STORY, EPIC, SUBTASK, FEATURE, INCIDENT
  statusId       String
  priority       String    @default("MEDIUM") // CRITICAL, HIGHEST, HIGH, MEDIUM, LOW, LOWEST
  reporterId     String
  assigneeId     String?
  teamId         String?
  epicId         String?
  sprintId       String?
  parentIssueId  String?
  componentId    String?
  estimatePoints Int?
  estimateHours  Float?
  remainingHours Float?
  timeSpentHours Float?    @default(0)
  startDate      DateTime?
  dueDate        DateTime?
  completedAt    DateTime?
  securityLevel  String    @default("PUBLIC") // PUBLIC, RESTRICTED
  position       Float     @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  /// B1 — optimistic locking. Incremented on every update. A client that
  /// sends a stale value is told so, rather than silently overwriting an edit
  /// it never saw. Default 0 so existing rows are immediately usable.
  version Int @default(0)

  /// D1 — full-text search vector over issueKey, title and description.
  ///
  /// A GENERATED column, maintained by Postgres, so it cannot drift from the
  /// columns it summarises. A trigger would work too and would be one more
  /// thing to forget on the next schema change.
  ///
  /// `Unsupported` because Prisma has no tsvector type: it knows the column
  /// exists, so `migrate diff` stays quiet, and excludes it from the client so
  /// nothing tries to write a generated column. Search reads it through
  /// $queryRaw in src/lib/search.ts.
  ///
  /// The `dbgenerated` default is how the GENERATED expression is declared:
  /// Prisma has no syntax for a generated column but reads the expression as a
  /// column default, so without this the PROD-0 drift check fails on every run.
  /// The text must be the CANONICAL form Postgres stores (with ::regconfig,
  /// ::text and its own parentheses), not the prettier version in the
  /// migration — `migrate diff` compares the normalised string.
  searchVector Unsupported("tsvector")? @default(dbgenerated("((setweight(to_tsvector('english'::regconfig, COALESCE(\"issueKey\", ''::text)), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, COALESCE(title, ''::text)), 'A'::\"char\")) || setweight(to_tsvector('english'::regconfig, COALESCE(description, ''::text)), 'B'::\"char\"))"))

  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status            WorkflowStatus     @relation(fields: [statusId], references: [id])
  reporter          User               @relation("IssueReporter", fields: [reporterId], references: [id])
  assignee          User?              @relation("IssueAssignee", fields: [assigneeId], references: [id])
  team              Team?              @relation(fields: [teamId], references: [id])
  epic              Epic?              @relation(fields: [epicId], references: [id])
  sprint            Sprint?            @relation(fields: [sprintId], references: [id])
  component         Component?         @relation(fields: [componentId], references: [id])
  parentIssue       Issue?             @relation("ParentChild", fields: [parentIssueId], references: [id], onDelete: SetNull)
  subIssues         Issue[]            @relation("ParentChild")
  subtasks          Subtask[]
  comments          Comment[]
  attachments       Attachment[]
  timeEntries       TimeEntry[]
  watchers          Watcher[]
  labels            IssueLabel[]
  activityLogs      ActivityLog[]
  customFieldValues CustomFieldValue[]
  activateDeliverable ActivateDeliverableLink?
  activateCriterionEvidence ActivateGateCriterion[] @relation("ActivateCriterionEvidence")
  outgoingDeps      IssueDependency[]  @relation("SourceDep")
  incomingDeps      IssueDependency[]  @relation("TargetDep")
  delegations       TaskDelegation[]

  @@unique([projectId, keyNumber])
  @@index([issueKey])
  @@index([projectId])
  @@index([projectId, statusId])
  @@index([projectId, sprintId])
  @@index([projectId, priority])
  @@index([projectId, issueType])
  @@index([projectId, dueDate])
  @@index([projectId, assigneeId])
  @@index([projectId, createdAt])
  @@index([assigneeId])
  @@index([reporterId])
  @@index([dueDate])
  @@index([updatedAt])
  @@index([parentIssueId])
  @@index([epicId])
  @@index([teamId])
  @@index([statusId])
  @@index([sprintId])
  @@index([componentId])
  /// D1 — the GIN index that makes `@@` a lookup rather than a scan over
  /// every row. Without it the tsvector column is just storage.
  @@index([searchVector], type: Gin)
}

model Subtask {
  id            String    @id @default(cuid())
  parentIssueId String
  title         String
  assigneeId    String?
  status        String    @default("TO_DO") // TO_DO, IN_PROGRESS, DONE
  priority      String    @default("MEDIUM")
  estimateHours Float?
  dueDate       DateTime?
  isCompleted   Boolean   @default(false)
  createdAt     DateTime  @default(now())

  /// M4 — optimistic locking. Incremented on every update; a client that
  /// sends a stale value is told so rather than silently overwriting an edit
  /// it never saw. Opt-in: a request with no `version` behaves as before.
  version Int @default(0)

  parentIssue Issue @relation(fields: [parentIssueId], references: [id], onDelete: Cascade)
  assignee    User? @relation(fields: [assigneeId], references: [id])

  @@index([parentIssueId])
  @@index([assigneeId])
}

model IssueDependency {
  id            String   @id @default(cuid())
  sourceIssueId String
  targetIssueId String
  type          String   @default("BLOCKS") // BLOCKS, BLOCKED_BY, RELATES_TO, DUPLICATES, FINISH_TO_START, START_TO_START
  createdAt     DateTime @default(now())

  sourceIssue Issue @relation("SourceDep", fields: [sourceIssueId], references: [id], onDelete: Cascade)
  targetIssue Issue @relation("TargetDep", fields: [targetIssueId], references: [id], onDelete: Cascade)

  @@unique([sourceIssueId, targetIssueId, type])
  @@index([targetIssueId])
}

model Comment {
  id        String   @id @default(cuid())
  issueId   String
  userId    String
  content   String // Markdown with @mentions
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// M4 — optimistic locking. Incremented on every update; a client that
  /// sends a stale value is told so rather than silently overwriting an edit
  /// it never saw. Opt-in: a request with no `version` behaves as before.
  version Int @default(0)

  /// D1 — full-text search vector over `content`.
  /// See Issue.searchVector for why the default is declared this way.
  searchVector Unsupported("tsvector")? @default(dbgenerated("to_tsvector('english'::regconfig, COALESCE(content, ''::text))"))

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@index([userId])
  @@index([searchVector], type: Gin)
}

model Attachment {
  id         String   @id @default(cuid())
  issueId    String
  uploaderId String
  fileName   String
  fileSize   Int
  mimeType   String
  fileUrl    String
  /// B3 — the object-store key, once the bytes have been moved out of
  /// `fileUrl`. Null means this row is still legacy base64 or an external
  /// URL; the content route serves all three, which is what lets the
  /// backfill run in the background instead of during a deploy.
  storageKey String?
  createdAt  DateTime @default(now())

  issue    Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  uploader User  @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@index([uploaderId])
}

model Watcher {
  id        String   @id @default(cuid())
  issueId   String
  userId    String
  createdAt DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issueId, userId])
  @@index([userId])
}

model Label {
  id        String   @id @default(cuid())
  projectId String
  name      String
  color     String   @default("#6b7280")
  createdAt DateTime @default(now())

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  IssueLabel[]

  @@unique([projectId, name])
}

model IssueLabel {
  id      String @id @default(cuid())
  issueId String
  labelId String

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([issueId, labelId])
  @@index([labelId])
}

model ActivityLog {
  id           String   @id @default(cuid())
  issueId      String
  actorId      String
  actionType   String // CREATED, UPDATED_STATUS, UPDATED_ASSIGNEE, COMMENTED, ETC.
  fieldChanged String?
  oldValue     String?
  newValue     String?
  timestamp    DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actor User  @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@index([issueId, timestamp])
  @@index([actorId])
  @@index([actorId, timestamp])
}

model TimeEntry {
  id              String   @id @default(cuid())
  issueId         String
  userId          String
  durationMinutes Int
  workDate        DateTime @default(now())
  description     String?
  createdAt       DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@index([issueId, workDate])
  @@index([userId])
  @@index([userId, workDate])
}

// -------------------------------------------------------------
// CUSTOM FIELDS & AUTOMATION
// -------------------------------------------------------------
model CustomField {
  id          String   @id @default(cuid())
  scopeType   String   @default("PROJECT") // ORG, WORKSPACE, PROJECT
  scopeId     String
  name        String
  fieldType   String   @default("TEXT") // TEXT, NUMBER, DATE, DROPDOWN, MULTISELECT, CHECKBOX, USER, URL
  optionsJson String? // JSON array for dropdown choices
  isRequired  Boolean  @default(false)
  createdAt   DateTime @default(now())

  values CustomFieldValue[]
}

model CustomFieldValue {
  id            String    @id @default(cuid())
  customFieldId String
  issueId       String
  valueString   String?
  valueNumber   Float?
  valueDate     DateTime?
  valueJson     String?

  customField CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  issue       Issue       @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([customFieldId, issueId])
  @@index([issueId])
}

model AutomationRule {
  id             String   @id @default(cuid())
  projectId      String
  name           String
  triggerType    String // ISSUE_CREATED, STATUS_CHANGED, ASSIGNEE_CHANGED, DUE_DATE
  triggerConfig  String? // JSON
  conditionRules String? // JSON
  actionType     String // CHANGE_STATUS, ASSIGN_USER, ADD_COMMENT, NOTIFY
  actionConfig   String? // JSON
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  /// M4 — optimistic locking. Incremented on every update; a client that
  /// sends a stale value is told so rather than silently overwriting an edit
  /// it never saw. Opt-in: a request with no `version` behaves as before.
  version Int @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model RecurringTask {
  id           String    @id @default(cuid())
  projectId    String
  scheduleCron String // DAILY, WEEKLY, MONTHLY
  templateData String // JSON of issue title, type, priority, assignee, etc.
  isActive     Boolean   @default(true)
  lastRunAt    DateTime?
  nextRunAt    DateTime?
  createdAt    DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// -------------------------------------------------------------
// SUPER ADMIN & PLATFORM GOVERNANCE
// -------------------------------------------------------------
model Notification {
  id        String   @id @default(cuid())
  userId    String
  // Who caused this notification, when it was a person rather than the system.
  // Nullable: system notifications have no actor, and rows created before this
  // column existed have none either. Used to show the actor's avatar.
  actorId   String?
  title     String
  message   String
  linkUrl   String?
  type      String   @default("INFO") // MENTION, ASSIGNMENT, STATUS, DUE_DATE
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SetNull, not Cascade: deleting a user must not delete notifications sent
  // to other people just because that user triggered them.
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([actorId])
}

model FeatureFlag {
  id              String   @id @default(cuid())
  key             String   @unique // e.g. SCRUM, TIMELINE, AUTOMATION, CUSTOM_FIELDS, AI_ASSISTANT
  description     String?
  isGlobalEnabled Boolean  @default(true)
  orgOverrides    String? // JSON mapping orgId -> boolean
  createdAt       DateTime @default(now())
}

model SystemAnnouncement {
  id             String    @id @default(cuid())
  title          String
  message        String
  severity       String    @default("INFO") // INFO, WARNING, CRITICAL
  // Legacy free-text audience label, kept so existing rows and the old admin
  // form keep working. Actual targeting is audienceMode + targets below.
  targetAudience String    @default("ALL") // ALL, ORGS, USERS
  // ALL  = every signed-in user (a platform-wide broadcast)
  // FILTERED = only users matching `targets`
  audienceMode   String    @default("ALL") // ALL, FILTERED
  // How targets of DIFFERENT kinds combine. Within one kind it is always OR.
  //   ANY = match any kind        (Project X  OR  all Clients)
  //   ALL = match every kind used (Project X AND only its Clients)
  matchMode      String    @default("ANY") // ANY, ALL
  // Plain column rather than a relation: an announcement outlives the admin who
  // wrote it, and deleting that account must not cascade into the audit trail.
  createdById    String?
  isActive       Boolean   @default(true)
  startsAt       DateTime  @default(now())
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  targets AnnouncementTarget[]

  @@index([isActive, startsAt])
}

/// One audience rule on an announcement. Several rows of the same `kind` are
/// alternatives (OR); how kinds combine is SystemAnnouncement.matchMode.
model AnnouncementTarget {
  id             String @id @default(cuid())
  announcementId String
  // ORG | PROJECT | TEAM | USER | USER_TYPE | ORG_ROLE | PROJECT_ROLE
  kind           String
  /// An id for ORG/PROJECT/TEAM/USER, or a value such as CLIENT / PROJECT_ADMIN.
  value          String

  announcement SystemAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, kind, value])
  @@index([announcementId])
  @@index([kind, value])
}

model PlatformAuditLog {
  id             String   @id @default(cuid())
  actorId        String
  action         String // TENANT_SUSPENDED, ROLE_CHANGED, USER_STATUS, MAINTENANCE_MODE
  targetResource String
  orgId          String?
  details        String? // JSON details of changes
  ipAddress      String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
  @@index([orgId])
}

model MaintenanceMode {
  id         String   @id @default(cuid())
  isActive   Boolean  @default(false)
  message    String?
  allowedIps String? // JSON list of exempt IPs
  updatedAt  DateTime @updatedAt
}

model Webhook {
  id        String   @id @default(cuid())
  orgId     String
  projectId String?
  targetUrl String
  secret    String
  events    String // Comma-separated or JSON of events
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  /// C1 — per-endpoint circuit breaker.
  ///
  /// An endpoint that has been dead for a week should not be retried at full
  /// rate forever: it wastes the worker on deliveries that cannot succeed and
  /// buries the endpoints that CAN. After a threshold of consecutive failures
  /// the endpoint is suspended until `disabledUntil`, and one success resets
  /// the counter. `isActive` stays the tenant's own switch; this is ours.
  consecutiveFailures Int       @default(0)
  disabledUntil       DateTime?

  organization Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project      Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([orgId])
  @@index([projectId])
}

/// C1 — one row per webhook delivery attempt sequence.
///
/// WHY A TABLE AND NOT A FIRE-AND-FORGET fetch()
///
/// Delivery used to be `fetch(...)` with no await: the request returned, the
/// promise was left running, and nothing recorded whether it ever completed.
/// A receiver returning a transient 500 lost the event permanently, and there
/// was no way for anyone — the tenant or us — to find out that it had. On a
/// short-lived process the request could be torn down before the socket even
/// opened.
///
/// The row is written BEFORE the attempt, so an event that was accepted is
/// never silently dropped: worst case it is a PENDING row a worker picks up.
/// That is the difference between at-most-once and at-least-once, and a
/// receiver that cannot tolerate a duplicate can use `id` to dedupe — which is
/// why it is sent as the X-Eitekh-Delivery header.
model WebhookDelivery {
  id        String @id @default(cuid())
  webhookId String
  eventType String
  /// The exact bytes that were signed and sent. Kept so a retry re-sends the
  /// same payload rather than a regenerated one, and so support can answer
  /// "what did you actually send us".
  payload   String

  /// PENDING | DELIVERING | DELIVERED | FAILED | DEAD
  /// FAILED is retryable; DEAD has exhausted its attempts.
  status   String @default("PENDING")
  attempts Int    @default(0)

  /// When a worker may next try. Set to now() on creation and pushed out by
  /// the backoff on each failure.
  nextAttemptAt DateTime  @default(now())
  lastAttemptAt DateTime?
  deliveredAt   DateTime?

  /// What the receiver said. Truncated: a body is diagnostic, not storage.
  responseStatus Int?
  responseBody   String?
  error          String?

  /// Set while an instance holds the row, so two workers cannot deliver the
  /// same event twice. See the claim query in src/lib/webhook-delivery.ts.
  claimedBy String?
  claimedAt DateTime?

  createdAt DateTime @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  /// The worker's query: due, retryable rows, oldest first.
  @@index([status, nextAttemptAt])
  /// The admin history view.
  @@index([webhookId, createdAt])
  @@index([createdAt])
}

// -------------------------------------------------------------
// EMAIL CONFIGURATION & NOTIFICATION TEMPLATES
// -------------------------------------------------------------
model SystemEmailConfig {
  id          String   @id @default(cuid())
  senderEmail String   @default("cocofbd@gmail.com")
  senderName  String   @default("Eitekh WorkOS")
  smtpHost    String?  @default("smtp.gmail.com")
  smtpPort    Int?     @default(587)
  smtpUser    String?  @default("cocofbd@gmail.com")
  smtpPass    String?
  isSecure    Boolean  @default(false)
  isEnabled   Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model EmailTemplate {
  id          String   @id @default(cuid())
  key         String   @unique // WELCOME, ISSUE_ASSIGNED, MENTION, COMMENT_ADDED, SPRINT_STARTED, STATUS_CHANGED, PASSWORD_RESET
  name        String
  description String?
  subject     String
  bodyHtml    String
  variables   String? // JSON array of available variables e.g. ["userName", "issueKey", "issueTitle", "actionUrl"]
  version     Int      @default(1)
  updatedAt   DateTime @updatedAt
}

model EmailTemplateVersion {
  id          String   @id @default(cuid())
  templateKey String
  version     Int
  subject     String
  bodyHtml    String
  savedBy     String? // userId of the admin who saved this version
  savedAt     DateTime @default(now())

  @@unique([templateKey, version])
  @@index([templateKey])
}

model EmailLog {
  id          String   @id @default(cuid())
  to          String
  from        String
  subject     String
  bodySnippet String?
  templateKey String?
  status      String   @default("SENT") // SENT, MOCKED, FAILED
  error       String?
  createdAt   DateTime @default(now())
}

/// C2 — the email outbox.
///
/// WHY THIS REPLACES AN IN-MEMORY ARRAY
///
/// Queued mail lived in `NotificationEngine.emailQueue`, a plain array on the
/// process. Three consequences, none of them visible from inside the app:
///
///   - a restart or a deploy discarded everything not yet sent, silently;
///   - the retry timer was per-instance, so with several instances each one
///     retried only what it happened to enqueue;
///   - nothing outside that process could see the queue, so "was the
///     invitation sent?" had no answer.
///
/// The flows this affects are the ones a locked-out user cannot work around:
/// password resets, OTP codes and invitations. Losing one is a support ticket
/// at best.
///
/// EmailLog is not a substitute. It records what happened to an attempt AFTER
/// the fact; this is the work still to do. Both exist on purpose.
model EmailOutbox {
  id String @id @default(cuid())

  to            String
  templateKey   String?
  /// JSON. The variables the template is rendered with.
  variables     String?
  customSubject String?
  customHtml    String?

  /// PENDING | SENDING | SENT | FAILED | DEAD
  status   String @default("PENDING")
  attempts Int    @default(0)

  nextAttemptAt DateTime  @default(now())
  lastAttemptAt DateTime?
  sentAt        DateTime?
  error         String?

  /// Set while an instance holds the row, so two workers cannot send the same
  /// message twice. Same claim pattern as WebhookDelivery.
  claimedBy String?
  claimedAt DateTime?

  /// Deduplicates at the point of enqueue: a retried request that would queue
  /// the same message twice is rejected by the unique index rather than
  /// producing two emails.
  idempotencyKey String? @unique

  createdAt DateTime @default(now())

  @@index([status, nextAttemptAt])
  @@index([createdAt])
  @@index([to])
}

model Leave {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  startDate      DateTime
  endDate        DateTime
  leaveType      String   @default("Annual Leave") // Annual Leave, Sick Leave, Personal, Other
  status         String   @default("ACTIVE") // ACTIVE, CANCELLED, COMPLETED
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  delegations  TaskDelegation[]

  @@index([userId, startDate, endDate])
  @@index([organizationId, startDate, endDate])
}

model TaskDelegation {
  id                 String    @id @default(cuid())
  leaveId            String?
  issueId            String
  originalAssigneeId String
  delegateUserId     String
  startDate          DateTime
  endDate            DateTime
  status             String    @default("ACTIVE") // ACTIVE, ENDED, CANCELLED
  reason             String?
  createdBy          String
  createdAt          DateTime  @default(now())
  endedAt            DateTime?

  leave            Leave?              @relation(fields: [leaveId], references: [id], onDelete: SetNull)
  issue            Issue               @relation(fields: [issueId], references: [id], onDelete: Cascade)
  originalAssignee User                @relation("DelegationOriginalAssignee", fields: [originalAssigneeId], references: [id], onDelete: Cascade)
  delegateUser     User                @relation("DelegationDelegateUser", fields: [delegateUserId], references: [id], onDelete: Cascade)
  creator          User                @relation("DelegationCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  history          DelegationHistory[]

  @@index([issueId, status])
  @@index([originalAssigneeId, startDate, endDate])
  @@index([delegateUserId, startDate, endDate])
  @@index([leaveId])
  @@index([status])
  @@index([createdBy])
}

model DelegationHistory {
  id           String   @id @default(cuid())
  delegationId String
  actorId      String
  action       String // DELEGATED, ACCEPTED, WORKED_ON, UPDATED, COMPLETED, ENDED, CANCELLED
  details      String?
  timestamp    DateTime @default(now())

  delegation TaskDelegation @relation(fields: [delegationId], references: [id], onDelete: Cascade)
  actor      User           @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([delegationId])
  @@index([timestamp])
  @@index([actorId])
}

/// PROD-2. The shared backing store for rate limiting.
///
/// This table exists because a rate limit held in a process-local `Map` is not
/// a rate limit once there is more than one process: N instances behind a load
/// balancer give an attacker N x the configured ceiling, and every deploy
/// resets every counter. The failure is silent -- the code reads correctly and
/// the tests pass -- which is what made it a blocker rather than a nit.
///
/// One row per (bucket, subject) window. Increments go through a single
/// INSERT ... ON CONFLICT DO UPDATE ... RETURNING, so the read and the write
/// are one atomic statement; see src/lib/rate-limit-store.ts for why a
/// read-then-write here would race.
///
/// Rows are disposable: `resetAt` in the past means the window has lapsed and
/// the next hit restarts it, so a sweep only reclaims space and can never
/// affect a decision.
model RateLimitCounter {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

/// PROD-3 / B13. The PBAC authorization model, in the database.
///
/// This used to live in `.data/pbac-store.json` on one instance's disk, plus
/// in-memory Maps. Two instances therefore held two divergent copies of the
/// authorization model itself and each wrote its own file: not a stale-cache
/// problem but split-brain in the permission system, where a role edited on
/// instance A might simply not exist on instance B.
///
/// Writes are per-entity rather than whole-model, so two instances editing
/// different roles in the same organization cannot clobber one another.
model PbacRole {
  id          String   @id
  orgId       String
  name        String
  slug        String
  description String   @default("")
  scope       String   @default("ORG") // PROJECT | WORKSPACE | ORG
  projectId   String?
  projectName String?
  status      String   @default("ACTIVE") // ACTIVE | INACTIVE
  isSystem    Boolean  @default(false)
  permissions String[]
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  assignments PbacUserRoleAssignment[]

  @@index([orgId])
  @@index([orgId, projectId])
  @@index([orgId, slug])
}

/// Which users hold which roles. The composite primary key makes a duplicate
/// assignment impossible at the database level rather than by convention.
model PbacUserRoleAssignment {
  userId    String
  roleId    String
  orgId     String
  createdAt DateTime @default(now())

  role PbacRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([orgId])
  @@index([userId])
  @@index([roleId])
}

/// Per-organization state, and the mechanism that keeps instances consistent.
///
/// `version` is bumped on every mutation to the organization's authorization
/// model. Each instance re-reads it on a short interval and reloads when it
/// changes, which bounds how long a revoked permission can still be honoured
/// somewhere else. The version is also stamped into capability-cache keys, so
/// a bump makes every stale entry unreachable without an explicit sweep.
model PbacOrgState {
  orgId     String   @id
  seeded    Boolean  @default(false)
  version   Int      @default(1)
  updatedAt DateTime @default(now())
}

/// The PBAC audit trail. Previously capped at 2000 entries inside a JSON file,
/// which meant the record of who changed permissions was both lossy and
/// per-instance.
model PbacAuditRecord {
  id            String   @id
  orgId         String
  actorId       String
  actorName     String   @default("")
  actorEmail    String   @default("")
  action        String
  entityType    String // ROLE | USER_ROLE | SYSTEM
  entityId      String
  entityName    String?
  previousState Json?
  newState      Json?
  status        String   @default("SUCCESS") // SUCCESS | FAILURE
  errorDetails  String?
  createdAt     DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([actorId])
}

/// PROD-4. The cross-instance relay for real-time (SSE) events.
///
/// `syncEngine.clients` is a per-process Map of open SSE connections, which is
/// correct — a connection belongs to the process holding the socket. What was
/// missing is a way for an event published on one instance to reach the
/// browsers connected to the others. Without it, real-time collaboration
/// "randomly" fails depending on which instance each user landed on, and works
/// perfectly in single-instance testing, so it would not be caught before
/// launch.
///
/// Events are inserted here and announced with Postgres NOTIFY; every instance
/// LISTENs, fetches the row and relays to its own clients. The row exists
/// rather than the payload riding on the notification for two reasons: NOTIFY
/// payloads are capped at 8000 bytes, and a durable row lets a client that
/// reconnects replay what it missed via Last-Event-ID.
///
/// Rows are short-lived; see the retention sweep in src/lib/sync-bus.ts.
model SyncEventOutbox {
  id        String   @id
  /// Project-scoped events carry a projectId; per-user events carry a userId.
  projectId String?
  userId    String?
  payload   Json
  /// The instance that published it, so it can skip its own echo.
  originId  String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([projectId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// SAP Activate
//
// Seven additive tables. NO column changes to Issue or Project, deliberately:
// an Activate deliverable IS an Issue, and a phase link is a row beside it
// rather than a field on it. That keeps every non-Activate project byte
// identical, and makes disabling the feature inert rather than a migration.
//
// Workstreams are DATA, not an enum. SAP has renamed them at least once —
// Organisational Change Management is now absorbed into Solution Adoption —
// and an enum would make a vocabulary change a schema change.
// ─────────────────────────────────────────────────────────────────────────────

/// One per project. Absent means the project is not running Activate at all,
/// which is the state every existing project is in.
model ActivateProfile {
  id                String   @id @default(cuid())
  projectId         String   @unique
  enabled           Boolean  @default(false)
  methodologyVersion String  @default("2024")
  /// Phase key the project currently sits in. Null until phases are seeded.
  currentPhaseKey   String?
  /// Reserved for per-project tailoring (skipped phases, renamed workstreams).
  configJson        String?
  /// THE STAMP. Which template this project was seeded from, and at which
  /// version. Null means the built-in methodology as it stood before templates
  /// existed, which is why it is nullable rather than backfilled: a project
  /// seeded in 2026 was not stamped, and inventing a stamp for it would be a
  /// claim nobody made.
  ///
  /// Kept as a plain id with NO relation, so deleting a template can never
  /// cascade into a running project's profile. A project's plan must survive
  /// the template it came from.
  templateId        String?
  templateVersion   Int?
  /// The allocator for custom scope-item codes, and the reason it lives here
  /// rather than being derived from the items themselves: derived from
  /// `max(code)`, removing every custom item would hand the next one CUS-01
  /// again, and a workshop's minutes citing CUS-01 would then point at a
  /// different item. This only ever goes up. Reconciled against the highest
  /// code that exists, the same way `Project.issueCounter` is.
  customScopeCounter Int     @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  version           Int      @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

/// A named, versioned methodology: the phases, workstreams, gates and criteria
/// a project is seeded FROM.
///
/// WHY orgId IS NULLABLE
///
/// Null means built-in — shipped with the product, identical for everyone,
/// and read-only. Set means an organization's own, which is how a customer
/// tailors the methodology without waiting for us. One table covers both
/// rather than forcing a choice between "we ship templates" and "customers
/// author them"; both are true.
///
/// WHY A PUBLISHED TEMPLATE IS IMMUTABLE
///
/// A project stamps `templateId` + `templateVersion` and keeps them. Editing a
/// published template would rewrite the plan of every project already running
/// against it, retroactively and silently. Improvement is a NEW version, which
/// a project adopts only by asking.
model MethodTemplate {
  id          String   @id @default(cuid())
  /// Null = built-in and read-only. Set = this organization's own.
  orgId       String?
  /// Stable across versions. `SAP_ACTIVATE` is the built-in one.
  key         String
  name        String
  /// A product line or delivery flavour — "SuccessFactors", "S/4HANA".
  variant     String?
  version     Int      @default(1)
  /// DRAFT | PUBLISHED | RETIRED. Only PUBLISHED may be stamped onto a project.
  status      String   @default("PUBLISHED")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  phases       TemplatePhase[]
  workstreams  TemplateWorkstream[]
  modules      TemplateModule[]

  @@unique([orgId, key, version])
  @@index([orgId])
  @@index([status])
}

model TemplatePhase {
  id          String   @id @default(cuid())
  templateId  String
  key         String
  name        String
  position    Int      @default(0)
  purpose     String?
  createdAt   DateTime @default(now())

  template MethodTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  gates    TemplateGate[]

  @@unique([templateId, key])
  @@index([templateId])
}

model TemplateWorkstream {
  id         String   @id @default(cuid())
  templateId String
  key        String
  name       String
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  template MethodTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, key])
  @@index([templateId])
}

model TemplateGate {
  id          String   @id @default(cuid())
  phaseId     String
  name        String
  description String?
  isMandatory Boolean  @default(true)
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  phase    TemplatePhase           @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  criteria TemplateGateCriterion[]

  @@index([phaseId])
}

model TemplateGateCriterion {
  id        String   @id @default(cuid())
  gateId    String
  criterion String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  gate TemplateGate @relation(fields: [gateId], references: [id], onDelete: Cascade)

  @@index([gateId])
}

model ActivatePhase {
  id          String    @id @default(cuid())
  projectId   String
  /// DISCOVER | PREPARE | EXPLORE | REALIZE | DEPLOY | RUN
  key         String
  name        String
  position    Int       @default(0)
  status      String    @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETED, SKIPPED
  ownerId     String?
  startDate   DateTime?
  targetDate  DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Optimistic locking. A gate sign-off must not race a phase edit.
  version     Int       @default(0)
  /// The allocator for this phase's deliverable codes — D-01, D-02, and so on.
  ///
  /// It only ever goes up. Derived from the highest code present instead, a
  /// phase whose D-03 was removed would hand the next deliverable D-03 again,
  /// and a status report or a meeting note citing D-03 would come to mean a
  /// different piece of work. Reconciled against the highest code that exists
  /// before it is used, the same rule `Project.issueCounter` follows for issue
  /// keys and `ActivateProfile.customScopeCounter` for scope items.
  deliverableCounter Int  @default(0)

  project     Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner       User?                     @relation("ActivatePhaseOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  gates       ActivateGate[]
  deliverables ActivateDeliverableLink[]

  @@unique([projectId, key])
  @@index([projectId])
  @@index([projectId, position])
}

/// Spans phases — a workstream is not owned by one. Seeded per project so a
/// customer can rename or drop one without affecting anybody else.
model ActivateWorkstream {
  id        String   @id @default(cuid())
  projectId String
  key       String
  name      String
  ownerId   String?
  status    String   @default("ACTIVE") // ACTIVE, INACTIVE
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project      Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner        User?                     @relation("ActivateWorkstreamOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  deliverables ActivateDeliverableLink[]

  @@unique([projectId, key])
  @@index([projectId])
}

/// Makes an existing Issue a deliverable of a phase.
///
/// Unique on issueId: an issue is a deliverable of at most one phase. Without
/// that constraint the readiness aggregations would double-count.
model ActivateDeliverableLink {
  id             String   @id @default(cuid())
  issueId        String   @unique
  phaseId        String
  workstreamId   String?
  isMandatory    Boolean  @default(false)
  /// Identifies the SAP accelerator this deliverable was created from.
  acceleratorKey String?
  /// What GENERATED this deliverable, if anything did: `delta:<id>` for an
  /// authored delta, `rule:<decisionId>:<rule>` for one a generation rule
  /// added. Unique, which is what makes re-running generation converge
  /// instead of duplicating — no bookkeeping table required.
  ///
  /// Deliberately not positional. A backlog numbered by iteration order
  /// renumbers itself whenever a decision is added, which breaks the moment
  /// anyone cites an item in a meeting.
  originKey      String?  @unique
  /// ADOPT | CONFIGURE | EXTEND | INTEGRATE | DEFER | OUT_OF_SCOPE — the
  /// outcome of a fit-to-standard workshop, using the same vocabulary as
  /// ActivateDecision so there is one set of words rather than two.
  /// Null means the item has not been through one yet, which is a real and
  /// common state during Explore, so it is not defaulted to FIT: recording
  /// "we looked at this and it fits" is a decision somebody made, and it must
  /// not be indistinguishable from nobody having looked.
  fitGapStatus   String?
  /// The worksheet code — D-01, D-02 — unique within the phase.
  ///
  /// Nullable because most deliverables never get one: an issue linked to a
  /// phase from the board, or generated from a decision, is a deliverable
  /// without being a numbered line on a phase worksheet. Backfilling codes
  /// for those would invent an ordering nobody agreed.
  phaseCode      String?
  createdAt      DateTime @default(now())

  issue      Issue               @relation(fields: [issueId], references: [id], onDelete: Cascade)
  phase      ActivatePhase       @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  workstream ActivateWorkstream? @relation(fields: [workstreamId], references: [id], onDelete: SetNull)

  @@unique([phaseId, phaseCode])
  @@index([phaseId])
  @@index([workstreamId])
}

model ActivateGate {
  id          String   @id @default(cuid())
  phaseId     String
  name        String
  description String?
  isMandatory Boolean  @default(true)
  position    Int      @default(0)
  /// OPEN, RAISED, APPROVED, REJECTED. A CACHE of the approval ledger — see
  /// deriveGateStatus in src/lib/activate-gates.ts. Never written on its own.
  status      String   @default("OPEN")
  /// SEPARATION OF DUTIES. Who submitted this gate for sign-off, and when.
  /// The rule "whoever raises a gate cannot approve it" needs a stored answer
  /// to "who raised it"; deriving it from the audit log would make an
  /// authorization control depend on log retention. Nullable because a gate
  /// starts OPEN and unraised. Re-raising a rejected gate overwrites both,
  /// which is correct — the question is who is asking for THIS sign-off, and
  /// the previous attempt survives in the approval ledger.
  raisedById  String?
  raisedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  phase      ActivatePhase           @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  raisedBy   User?                   @relation("ActivateGateRaiser", fields: [raisedById], references: [id], onDelete: SetNull)
  criteria   ActivateGateCriterion[]
  approvals  ActivateGateApproval[]

  @@index([phaseId])
  @@index([raisedById])
}

model ActivateGateCriterion {
  id              String   @id @default(cuid())
  gateId          String
  criterion       String
  status          String   @default("PENDING") // PENDING, MET, NOT_MET, WAIVED
  /// Free-text pointer to evidence (a drill name, a document, a run id).
  evidenceRef     String?
  /// Or a hard link to the Issue carrying the evidence.
  evidenceIssueId String?
  position        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  gate          ActivateGate @relation(fields: [gateId], references: [id], onDelete: Cascade)
  evidenceIssue Issue?       @relation("ActivateCriterionEvidence", fields: [evidenceIssueId], references: [id], onDelete: SetNull)

  @@index([gateId])
}

/// APPEND ONLY.
///
/// There is no update or delete path in the schema's intent and none in the
/// routing layer: a sign-off history that can be edited is not a sign-off
/// history. A reversal is a new row with decision REJECTED, not an edit.
model ActivateGateApproval {
  id         String   @id @default(cuid())
  gateId     String
  approverId String
  decision   String // APPROVED, REJECTED
  comment    String?
  decidedAt  DateTime @default(now())

  gate     ActivateGate @relation(fields: [gateId], references: [id], onDelete: Cascade)
  approver User         @relation("ActivateGateApprover", fields: [approverId], references: [id], onDelete: Cascade)

  @@index([gateId])
  @@index([approverId])
}

/// A module within a methodology template — a grouping of scope items that a
/// project can switch in or out as a whole.
///
/// Modules are the layer that makes one template reusable. A suite template
/// plus module content beats a template per module combination: the common
/// material is written once, and a project says which modules it is doing.
model TemplateModule {
  id          String   @id @default(cuid())
  templateId  String
  key         String
  name        String
  description String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  template   MethodTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  scopeItems TemplateScopeItem[]

  @@unique([templateId, key])
  @@index([templateId])
}

/// One thing a fit-to-standard workshop decides about.
///
/// A scope item is the unit of the CONVERSATION; a decision is the unit of the
/// RECORD; a delta is the unit of WORK. Keeping them separate is what lets a
/// decision of "adopt standard" be a real, reportable outcome rather than an
/// absence of data.
model TemplateScopeItem {
  id            String   @id @default(cuid())
  moduleId      String
  code          String
  name          String
  /// Which workstream owns it, by key — matched against the template's own
  /// workstreams rather than a foreign key, so a module can be authored
  /// independently of the workstream list it references.
  workstreamKey String
  /// Comma-separated flags that let a generation rule fire without any rule
  /// hard-coding a scope item code. `ux` means employees or managers see it.
  tags          String?
  position      Int      @default(0)
  createdAt     DateTime @default(now())

  module TemplateModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, code])
  @@index([moduleId])
}

/// Whether a project is doing a module, and in which wave.
///
/// A wave number as well as a flag, because "not doing it" and "not doing it
/// yet" are different answers and a steering committee asks the difference
/// every month. A boolean alone forces one to stand for both.
model ActivateProjectModule {
  id         String   @id @default(cuid())
  projectId  String
  /// TemplateModule id. No foreign key, for the same reason the profile's
  /// template stamp has none: a running project must outlive its template.
  moduleId   String
  inScope    Boolean  @default(true)
  waveNumber Int?
  ownerId    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner   User?   @relation("ActivateModuleOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@unique([projectId, moduleId])
  @@index([projectId])
}

/// What a project decided about one scope item.
model ActivateDecision {
  id              String    @id @default(cuid())
  projectId       String
  /// TemplateScopeItem id — again unlinked, so the decision survives the
  /// catalogue it was made against.
  scopeItemId     String
  /// ADOPT | CONFIGURE | EXTEND | INTEGRATE | DEFER | OUT_OF_SCOPE
  decision        String
  /// DRAFT | AGREED. Only AGREED counts as signed at a gate.
  status          String    @default("DRAFT")
  rationale       String?
  openQuestion    String?
  questionOwnerId String?
  decidedById     String?
  decidedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  /// Optimistic locking: a workshop has several people editing at once.
  version         Int       @default(0)

  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  decidedBy     User?           @relation("ActivateDecisionDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  questionOwner User?           @relation("ActivateQuestionOwner", fields: [questionOwnerId], references: [id], onDelete: SetNull)
  deltas        ActivateDelta[]

  @@unique([projectId, scopeItemId])
  @@index([projectId])
  @@index([projectId, decision])
}

/// One difference from the standard, sized and owned. The unit of work.
model ActivateDelta {
  id             String   @id @default(cuid())
  decisionId     String
  title          String
  /// CONFIGURATION | BUSINESS_RULE | WORKFLOW | REPORT | INTERFACE | CONVERSION | ENHANCEMENT | FORM
  buildType      String   @default("CONFIGURATION")
  priority       String   @default("SHOULD")
  size           String   @default("M")
  ownerId        String?
  /// Which phase this should land in, by key.
  targetPhaseKey String?
  note           String?
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  decision ActivateDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  owner    User?            @relation("ActivateDeltaOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([decisionId])
}

/// A scope item a PROJECT added for itself.
///
/// WHY THIS IS NOT A ROW IN TemplateScopeItem
///
/// The built-in methodology and every content pack are shared: one row, seen
/// by every tenant. Writing a customer's own scope item into that catalogue
/// would show it to all of them. So a custom item lives here, scoped by
/// projectId with a real foreign key, and the catalogue a project sees is the
/// template's items plus its own — merged at read time, never merged in the
/// database.
///
/// `moduleId` is the TemplateModule this item is filed under, or null for the
/// project's own "Custom scope" grouping. No foreign key, for the same reason
/// the profile's template stamp has none: a project must outlive the template
/// it was seeded from.
model ActivateCustomScopeItem {
  id            String   @id @default(cuid())
  projectId     String
  moduleId      String?
  /// Unique within the project. Generated rather than typed, so two people
  /// adding an item in the same workshop cannot collide on a code that a
  /// decision log will later cite.
  code          String
  name          String
  workstreamKey String
  /// Comma-separated flags, same vocabulary as the template catalogue. `ux`
  /// is what makes the change-and-training rule fire.
  tags          String?
  position      Int      @default(0)
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("ActivateCustomScopeAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([projectId, code])
  @@index([projectId])
}
