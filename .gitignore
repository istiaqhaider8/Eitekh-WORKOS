# Database backups.
#
# /backups/ is the default BACKUP_DIR, but the scripts take --out and honour
# BACKUP_DIR, so dumps can land anywhere. These patterns are the backstop: a
# committed dump is every tenant's data in the repository, and `git rm` does
# not remove it from history.
/backups/
*.dump
*.dump.enc
*.dump.decrypted
*.decrypted

# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js build output
.next/
out/
build/
dist/

# TypeScript build info
*.tsbuildinfo

# Environment variables (keep .env.example tracked)
.env
.env*.local
.env.production
.env.staging

# Local SQLite databases & PBAC store
prisma/*.db
prisma/*.db-journal
# SQLite WAL sidecars (the database runs in WAL mode)
prisma/*.db-wal
prisma/*.db-shm
*.db
*.db-journal
*.db-wal
*.db-shm
.data/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# IDE & OS files
.vscode/
.idea/
*.suo
*.ntvs*
# Local scratch scripts
scratch/
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# B3 — local attachment storage (STORAGE_DRIVER=local-fs). Uploaded files,
# never source. Production uses an object store; see DEPLOYMENT.md.
/storage/
