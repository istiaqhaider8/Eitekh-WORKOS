# ==============================================================================
# EITEKH WORKOS — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and adjust values for your deployment environment.
# ==============================================================================

# Database Connection: PostgreSQL.
#
# SQLite is no longer supported (PROD-1). It has a single writer and is
# file-local, so concurrent writes serialise and more than one app instance
# cannot share the database. The Prisma provider is now "postgresql", and a
# file: URL is rejected by schema validation.
DATABASE_URL="postgresql://user:password@localhost:5432/eitekh_workos?schema=public"

# Pool sizing belongs in the URL, not in code. Respect
#   N_instances x connection_limit  <  Postgres max_connections
# or a rolling deploy will exhaust connections, which is a common and
# avoidable outage:
#   ...?schema=public&connection_limit=10&pool_timeout=20
#
# SET connection_limit EXPLICITLY. Unset, Prisma uses num_cpus * 2 + 1, so the
# pool silently changes with the host's core count — a container with fewer
# cores gets a smaller pool and a lower ceiling for no visible reason.
#
# Measured (A2, see DEPLOYMENT.md): with the default pool of 25 on a 12-core
# machine, 40 concurrent users ran at p95 74-103ms, and 80 users pushed issue
# update to p95 466ms against a 500ms target. The pool was the constraint, not
# the application. The knee moves with connection_limit, so re-measure after
# changing it.
#
# SHADOW_DATABASE_URL is only needed by `prisma migrate dev` and by CI's drift
# check. It must be a SEPARATE database: it gets dropped and recreated.
# SHADOW_DATABASE_URL="postgresql://user:password@localhost:5432/eitekh_shadow"


# ---------------------------------------------------------------------------
# Observability (PROD-7).
#
# Where errors and structured logs are shipped. UNSET MEANS CONSOLE ONLY:
# nothing is aggregated and nothing can alert, so you would learn about
# incidents from customers. The app logs a loud startup warning in production
# if this is missing — it does not refuse to boot, because an outage is a worse
# outcome than a monitoring gap.
#
# The transport posts JSON and is vendor-neutral; see DEPLOYMENT.md.
# TELEMETRY_ENDPOINT="https://your-collector.example/ingest"
# TELEMETRY_API_KEY="..."
#
# Lets a stack trace be mapped back to a build.
# RELEASE_SHA="set this from git rev-parse HEAD at deploy time"
#
# Alerting. ALERT_CHECK_SECRET is REQUIRED for POST /api/internal/alerts/check
# to do anything — without it the route refuses rather than defaulting to open,
# since dispatch reaches an external webhook. Call that endpoint on a schedule;
# see DEPLOYMENT.md.
# ALERT_CHECK_SECRET="a long random string"
# ALERT_WEBHOOK_URL="https://hooks.slack.com/services/..."
#
# Scheduled work. RECURRING_TASKS_SECRET is REQUIRED for
# POST /api/recurring-tasks/trigger. That route processes EVERY tenant's due
# recurring tasks, so it is a cron credential, not a user one — it used to
# accept any logged-in session, which let any user fire every other tenant's
# schedule. Unset, the route refuses rather than defaulting to open.
# RECURRING_TASKS_SECRET="a long random string"
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Real-time fan-out (PROD-4) uses the SAME DATABASE_URL above: each instance
# opens ONE extra Postgres connection to LISTEN for sync events published by
# the other instances. Count it when sizing connection_limit against
# max_connections — it is one per instance, not one per connected browser.
#
# If the listener cannot be established the app falls back to polling the
# SyncEventOutbox table once a second, so real-time keeps working with added
# latency rather than silently reverting to single-instance behaviour.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Rate limiting (PROD-2).
#
# The limiter is backed by a store every instance shares, so the configured
# ceiling is enforced in aggregate rather than per process. That store is the
# application Postgres above: there is nothing extra to provision.
#
# RATE_LIMIT_STORE=memory switches to a per-process store. It exists for local
# development without a database, and the app REFUSES TO START with it in
# production -- a per-process limiter silently grants N x the configured limit
# once there is more than one instance, and resets every counter on deploy.
#
# If the store is unreachable the limiter DENIES rather than allowing traffic
# through. Failing open would remove the brute-force ceiling on login and
# password reset during a database incident.
# RATE_LIMIT_STORE=memory

# Authentication & JWT
JWT_SECRET="generate-a-strong-random-secret-key-min-32-chars"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Session lifetime in days (default: 7). Both the JWT and the DB session record
# use this value. Cookie maxAge is derived from it automatically.
SESSION_EXPIRY_DAYS=7

# SMTP Email Configuration (Optional - for notifications & password resets)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@example.com"
SMTP_PASS="your-16-character-app-password"

# Email Sender (defaults if not set)
EMAIL_FROM="noreply@eitekh.com"
EMAIL_FROM_NAME="Eitekh WorkOS"

# Application Base URL (used in email links, notifications)
BASE_URL="http://localhost:3000"

# Field-level encryption key for sensitive DB columns (webhook secrets, MFA secrets).
# Generate with: openssl rand -hex 32
# REQUIRED in production — app falls back to JWT_SECRET in development only.
FIELD_ENCRYPTION_KEY="replace-with-output-of-openssl-rand-hex-32"

# Force HTTPS cookies in non-production environments
FORCE_HTTPS="false"

# Node Environment
NODE_ENV="development"

# ---------------------------------------------------------------------------
# Data retention (optional — the values below are the built-in defaults).
# Used by src/lib/data-retention.ts. If unset, these defaults apply silently,
# so set them explicitly if you have a defined retention policy.
# ---------------------------------------------------------------------------
SESSION_RETENTION_DAYS="90"
NOTIFICATION_RETENTION_DAYS="90"
ACTIVITY_LOG_RETENTION_DAYS="180"
EMAIL_LOG_RETENTION_DAYS="90"
AUDIT_LOG_RETENTION_DAYS="365"

# Session lifetime in days (optional — defaults to 7)
SESSION_EXPIRY_DAYS="7"

# Legacy alias for BASE_URL, kept because middleware.ts and src/lib/config.ts
# still read it (leftover from a NextAuth scaffold; next-auth is NOT installed).
# Prefer BASE_URL. If both are set, NEXTAUTH_URL wins.
# NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Backups (A1). The application does NOT take backups — see DEPLOYMENT.md.
# These only affect scripts/db-backup.mjs and scripts/db-restore.mjs when you
# run them. Nothing here schedules anything.
#
# BACKUP_DIR="./backups"     # local staging before you copy off-host
# BACKUP_RETAIN=7            # how many local dumps to keep
# PG_DUMP="/usr/bin/pg_dump" # only if the client tools are not on PATH
# PG_RESTORE="/usr/bin/pg_restore"
#
# BACKUP_ENCRYPTION_KEY — 64 hex characters. Generate with:
#     openssl rand -hex 32
#
# When set, db-backup.mjs writes an AES-256-GCM `.dump.enc` instead of a
# readable `.dump`, and db-restore.mjs requires the same key to read it. When
# unset the dump is PLAINTEXT: every tenant's data in the clear, on whatever
# disk took the backup and in whatever copies it off.
#
# This is NOT FIELD_ENCRYPTION_KEY, and it must not be the same value. They
# protect different things and rotate on different schedules: a backup you can
# read is a backup an attacker can read, and losing this key costs you the
# backups rather than the database.
#
# Store it somewhere the dumps are not. A key kept beside the file it decrypts
# is decoration.
#
# BACKUP_ENCRYPTION_KEY="replace-with-output-of-openssl-rand-hex-32"
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# TRUSTED_PROXY_HOPS is REQUIRED in production. It is the number of proxies
# between the internet and this process: 1 for a single nginx, 2 for a CDN in
# front of a load balancer, 0 if the app is exposed directly.
#
# X-Forwarded-For is written by the CALLER and appended to by each proxy, so
# the leftmost entry is whatever the client typed. Reading it let anyone pick
# their own rate-limit bucket by rotating the header — verified against a
# running server, where each new value started again at a full budget. The
# per-IP ceiling is the control in front of the UNAUTHENTICATED routes,
# login included, so that was a bypass of the brute-force protection.
#
# There is no safe default to infer, so an unset value refuses to boot.
#
# THE APPLICATION PORT MUST NOT BE REACHABLE EXCEPT THROUGH THE PROXY. With
# one trusted hop, a request that skipped the proxy carries a chain that looks
# exactly like a genuine one, and no code here can tell them apart.
TRUSTED_PROXY_HOPS="1"
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# ATTACHMENT STORAGE (B3). REQUIRED in production.
#
# Without it, uploaded files are stored base64-encoded in a Postgres column.
# One upload then inflates four things at once: the table, every backup (and
# therefore the restore time, and therefore the RTO), replication, and server
# memory — a base64 column is read whole, there is no streaming part of it.
#
# STORAGE_DRIVER="s3" works against AWS S3, Cloudflare R2, Backblaze B2,
# DigitalOcean Spaces and MinIO. Set S3_ENDPOINT for anything but AWS.
# STORAGE_DRIVER="s3"
# S3_BUCKET="eitekh-attachments"
# S3_REGION="eu-west-2"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"   # not AWS
# S3_SIGNED_URL_TTL_SECONDS="600"   # 30-3600; download links expire this fast
#
# A directory is acceptable for development, and in production ONLY if it is a
# genuinely shared volume (NFS/EFS) — otherwise instance A writes a file that
# instance B cannot see, and downloads 404 depending on which one answered.
# The boot guard refuses local-fs in production unless STORAGE_FS_SHARED=1.
# STORAGE_DRIVER="local-fs"
# STORAGE_FS_ROOT="/var/lib/eitekh/attachments"
# STORAGE_FS_SHARED="1"
#
# Existing base64 attachments are moved with:
#   node scripts/migrate-attachments.mjs --dry-run
#   node scripts/migrate-attachments.mjs
# It verifies each file by reading it back before recording the move, leaves
# fileUrl in place, and is safe to re-run.
# ---------------------------------------------------------------------------
