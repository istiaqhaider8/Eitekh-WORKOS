# ==============================================================================
# EITEKH WORKOS — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and adjust values for your deployment environment.
# ==============================================================================

# Database Connection: PostgreSQL.
#
# SQLite is no longer supported (PROD-1). It has a single writer and is
# file-local, so concurrent writes serialise and more than one app instance
# cannot share the database. The Prisma provider is now "postgresql", and a
# file: URL is rejected by schema validation.
DATABASE_URL="postgresql://user:password@localhost:5432/eitekh_workos?schema=public"

# Pool sizing belongs in the URL, not in code. Respect
#   N_instances x connection_limit  <  Postgres max_connections
# or a rolling deploy will exhaust connections, which is a common and
# avoidable outage:
#   ...?schema=public&connection_limit=10&pool_timeout=20
#
# SHADOW_DATABASE_URL is only needed by `prisma migrate dev` and by CI's drift
# check. It must be a SEPARATE database: it gets dropped and recreated.
# SHADOW_DATABASE_URL="postgresql://user:password@localhost:5432/eitekh_shadow"

# Authentication & JWT
JWT_SECRET=\generate-a-strong-random-secret-key-min-32-chars\
NEXT_PUBLIC_APP_URL=\http://localhost:3000\
# Session lifetime in days (default: 7). Both the JWT and the DB session record
# use this value. Cookie maxAge is derived from it automatically.
SESSION_EXPIRY_DAYS=7

# SMTP Email Configuration (Optional - for notifications & password resets)
SMTP_HOST=\smtp.gmail.com\
SMTP_PORT=\587\
SMTP_USER=\your-email@example.com\
SMTP_PASS=\your-16-character-app-password\

# Email Sender (defaults if not set)
EMAIL_FROM=\noreply@eitekh.com\
EMAIL_FROM_NAME=\Eitekh WorkOS\

# Application Base URL (used in email links, notifications)
BASE_URL=\http://localhost:3000\

# Field-level encryption key for sensitive DB columns (webhook secrets, MFA secrets).
# Generate with: openssl rand -hex 32
# REQUIRED in production — app falls back to JWT_SECRET in development only.
FIELD_ENCRYPTION_KEY=\replace-with-output-of-openssl-rand-hex-32\

# Force HTTPS cookies in non-production environments
FORCE_HTTPS=\false\

# Node Environment
NODE_ENV=\development\

# ---------------------------------------------------------------------------
# Data retention (optional — the values below are the built-in defaults).
# Used by src/lib/data-retention.ts. If unset, these defaults apply silently,
# so set them explicitly if you have a defined retention policy.
# ---------------------------------------------------------------------------
SESSION_RETENTION_DAYS=\90\
NOTIFICATION_RETENTION_DAYS=\90\
ACTIVITY_LOG_RETENTION_DAYS=\180\
EMAIL_LOG_RETENTION_DAYS=\90\
AUDIT_LOG_RETENTION_DAYS=\365\

# Session lifetime in days (optional — defaults to 7)
SESSION_EXPIRY_DAYS=\7\

# Legacy alias for BASE_URL, kept because middleware.ts and src/lib/config.ts
# still read it (leftover from a NextAuth scaffold; next-auth is NOT installed).
# Prefer BASE_URL. If both are set, NEXTAUTH_URL wins.
# NEXTAUTH_URL=\http://localhost:3000\
