# ==============================================================================
# EITEKH WORKOS — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and adjust values for your deployment environment.
# ==============================================================================

# Database Connection (Default: SQLite for development, PostgreSQL for production)
DATABASE_URL=" file:./dev.db\
# For PostgreSQL: DATABASE_URL=\postgresql://user:password@localhost:5432/eitekh_workos?schema=public\

# Authentication & JWT
JWT_SECRET=\generate-a-strong-random-secret-key-min-32-chars\
NEXT_PUBLIC_APP_URL=\http://localhost:3000\

# SMTP Email Configuration (Optional - for notifications & password resets)
SMTP_HOST=\smtp.gmail.com\
SMTP_PORT=\587\
SMTP_USER=\your-email@example.com\
SMTP_PASS=\your-16-character-app-password\

# Node Environment
NODE_ENV=\development\
